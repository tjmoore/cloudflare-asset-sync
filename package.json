{
  "name": "static-site-deploy-watcher",
  "version": "1.0.0",
  "description": "Watches a static site folder and deploys batched changes to a Cloudflare Worker with wrangler",
  "type": "module",
  "main": "dist/src/watcher.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/watcher.js",
    "test": "tsc && node --test dist/test/*.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.0"
  }
}
