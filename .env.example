CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Folder to watch (must match assets.directory in wrangler.jsonc)
WATCH_DIR=./site
# The URL of your site, used for sitemap generation
SITE_URL=
# Quiet period after the last change before deploying
DEBOUNCE_MS=5000
DEPLOY_ON_START=true
# Set true for bind-mounted volumes where inotify events are unreliable
USE_POLLING=false
MAX_RETRIES=3
RETRY_DELAY_MS=10000
# Extra wrangler args, e.g. "--env production"
WRANGLER_ARGS=
